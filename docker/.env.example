# Скопируйте в docker/.env и заполните значения.
# docker/.env в .gitignore — не коммитьте.

# Имя БД и пользователь панели
DB_NAME=monitoring
DB_USER=monitoring

# Пароль пользователя панели. Сгенерировать:
#   openssl rand -hex 16
DB_PASSWORD=

# Пароль root в MySQL (только для служебных задач внутри контейнера).
DB_ROOT_PASSWORD=

# Порт веб-интерфейса на хосте
WEB_PORT=8080
