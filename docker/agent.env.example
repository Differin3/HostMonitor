# Скопируйте в docker/.env.agent и заполните. Этот файл в .gitignore — не коммитьте.

# Корень панели (агент сам добавит /api/...). Без завершающего слэша.
MASTER_URL=https://hostmonitor-access-02.duckdns.org

# Одноразовый код из панели («Подключить ноду»). Живёт 15 минут, срабатывает один раз.
# После успешного enroll node.conf сохраняется в volume /data и код больше не нужен.
ENROLL_TOKEN=

# Имя ноды в панели. Пусто — возьмётся имя, выданное панелью при enroll.
NODE_NAME=

# Активный SNMP-опрос соседей и пассивный LLDP (нужен CAP_NET_RAW; в контейнере есть через privileged).
SNMP_ENABLED=true
LLDP_PASSIVE=true
